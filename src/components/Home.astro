---
// The whole one-page site for one language.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Brands from './Brands.astro';
import Services from './Services.astro';
import Work from './Work.astro';
import Gallery from './Gallery.astro';
import Team from './Team.astro';
import ContactForm from './ContactForm.astro';
import Footer from './Footer.astro';
import type { Content, Lang } from '../cms/schema';

interface Props { content: Content; lang: Lang; noindex?: boolean }
const { content, lang, noindex } = Astro.props;
const paths = { en: '/', hu: '/hu/' };
---
<Base {content} {lang} {paths} {noindex} preloader schema>
  <Header {content} {lang} {paths} home="" />
  <Hero hero={content.hero} {lang} />
  <Brands brands={content.brands} {lang} />
  <Services intro={content.intro} services={content.services} {lang} />
  <Work work={content.work} {lang} />
  <Gallery gallery={content.gallery} {lang} />
  <Team team={content.team} {lang} />
  <ContactForm form={content.form} {lang} />
  <Footer {content} {lang} home="" />
  <slot />
</Base>
