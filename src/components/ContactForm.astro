---
import { t, type Content, type Lang } from '../cms/schema';
import { inline } from '../cms/text';
import Br from './Br.astro';

interface Props { form: Content['form']; lang: Lang }
const { form, lang } = Astro.props;
---
<section class="form-section" id="contact" data-nav="contact">
  <div class="reveal">
    <p class="section-label">{t(form.label, lang)}</p>
    <h2 class="section-title"><Br text={t(form.title, lang)} /></h2>
    <p class="section-body">{t(form.body, lang)}</p>
  </div>

  <div id="formWrap">
    <form
      id="consultForm"
      action="/api/contact"
      method="post"
      novalidate
      data-err-required={t(form.errorRequired, lang)}
      data-err-email={t(form.errorEmail, lang)}
      data-err-phone={t(form.errorPhone, lang)}
      data-err-phone-suffix={t(form.errorPhoneSuffix, lang)}
      data-err-send={t(form.errorSend, lang)}
    >
      <div class="form-row">
        <div class="form-group">
          <label for="name">{t(form.name, lang)}</label>
          <input type="text" id="name" name="name" placeholder={t(form.namePlaceholder, lang)} autocomplete="name" required />
        </div>
        <div class="form-group">
          <label for="phone">{t(form.phone, lang)}</label>
          <input type="tel" id="phone" name="phone" placeholder={t(form.phonePlaceholder, lang)} autocomplete="tel" required />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="company">{t(form.company, lang)}</label>
          <input type="text" id="company" name="company" placeholder={t(form.companyPlaceholder, lang)} autocomplete="organization" required />
        </div>
        <div class="form-group">
          <label for="email">{t(form.email, lang)}</label>
          <input type="email" id="email" name="email" placeholder={t(form.emailPlaceholder, lang)} autocomplete="email" required />
        </div>
      </div>
      <div class="form-group">
        <label for="service">{t(form.service, lang)}</label>
        <select id="service" name="service" required>
          <option value="" disabled selected>{t(form.servicePlaceholder, lang)}</option>
          {form.options.map((option) => <option value={option.value}>{t(option.label, lang)}</option>)}
        </select>
      </div>
      <div class="form-group">
        <label for="message">{t(form.message, lang)}</label>
        <textarea id="message" name="message" placeholder={t(form.messagePlaceholder, lang)}></textarea>
      </div>

      <div class="hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <label class="form-consent">
        <input type="checkbox" id="consent" name="consent" required />
        <span class="consent-text" set:html={inline(t(form.consent, lang))} />
      </label>

      <div id="formError" role="alert" style="display:none;color:var(--red);font-size:12px;font-weight:600;letter-spacing:1px;margin-bottom:16px;"></div>

      <button type="submit" class="btn-submit">{t(form.submit, lang)}</button>
    </form>
  </div>

  <div id="formSuccess" style="display:none;text-align:center;padding:60px 0;">
    <div style="font-size:40px;margin-bottom:24px;">✓</div>
    <h3 style="font-size:26px;font-weight:900;letter-spacing:-0.5px;margin-bottom:14px;">{t(form.successTitle, lang)}</h3>
    <p style="font-size:16px;color:rgba(255,255,255,0.65);line-height:1.7;"><Br text={t(form.successBody, lang)} /></p>
  </div>
</section>
