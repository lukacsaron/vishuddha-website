---
import { t, type Content, type Lang } from '../cms/schema';
import { dotted } from '../cms/text';
import Br from './Br.astro';

interface Props { hero: Content['hero']; lang: Lang }
const { hero, lang } = Astro.props;
const type = (src: string) => (src.toLowerCase().endsWith('.webm') ? 'video/webm' : 'video/mp4');
// Phones and tablets held upright get the vertical clip. Must match the query in extras.css.
const MOBILE = '(orientation: portrait) and (max-width: 900px)';
const posters = [
  hero.poster && `--poster: url("${hero.poster}")`,
  hero.posterMobile && `--poster-mobile: url("${hero.posterMobile}")`,
].filter(Boolean).join('; ');
---
<section class="hero">
  {(hero.video || hero.videoMobile) && (
    <video autoplay muted loop playsinline style={posters || undefined}>
      {/* The browser plays the first source whose media query matches */}
      {hero.videoMobile && <source src={hero.videoMobile} type={type(hero.videoMobile)} media={MOBILE} />}
      {hero.video && <source src={hero.video} type={type(hero.video)} />}
    </video>
  )}

  <div class="hero-content">
    <p class="hero-eyebrow"><Br text={t(hero.eyebrow, lang)} /></p>

    <!-- H1 for SEO; styled identically via .hero-rolling-title -->
    <h1 class="hero-rolling-title">
      <span class="we-static">{t(hero.staticWord, lang)}</span>
      <span class="rolling-slot" id="rollingSlot">
        <div class="rolling-words" id="rollingWords">
          {hero.words.map((word) => <span>{t(word, lang)}</span>)}
        </div>
      </span>
    </h1>

    <p class="hero-sub">{dotted(t(hero.sub, lang))}</p>
    <a href="#contact" class="hero-cta">{t(hero.cta, lang)}</a>
  </div>
</section>
