# Environment variables to set in Coolify (Application → Environment Variables).
# Everything except ADMIN_PASSWORD is optional.

# Password for /admin. Use a long random one: this is the only thing protecting the admin.
ADMIN_PASSWORD=

# Key for signing admin sessions. If empty it is derived from the password.
SESSION_SECRET=

# Email a notification for each contact-form enquiry. Leave SMTP_HOST empty to only
# store enquiries in the admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where notifications go. Defaults to the contact email set in the admin.
NOTIFY_TO=
