# Required: the password for /admin
ADMIN_PASSWORD=change-me

# Optional: key for signing admin sessions. If unset it is derived from the password,
# so changing the password signs everyone out.
SESSION_SECRET=

# Where content.json, uploads/, history/ and enquiries.json live. Mount a persistent volume here.
DATA_DIR=./data

# Optional: email a notification for each enquiry. Without SMTP_HOST enquiries are only stored.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Defaults to the contact email set in the admin
NOTIFY_TO=

# Set to 1 only behind a reverse proxy you control (the Docker setup does this).
# It makes rate limits use the visitor address the proxy reports.
TRUST_PROXY=0

HOST=0.0.0.0
PORT=4321
